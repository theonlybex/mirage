{
  "name": "wordedits",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/shared packages/sidecars packages/core packages/mcp packages/hooks packages/viewer packages/viewer/tsconfig.ui.json packages/viewer/tsconfig.e2e.json scripts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "mirage": "tsx scripts/mirage.ts",
    "fixtures:speech": "tsx scripts/make-speech-fixture.ts",
    "build:plugin": "tsx scripts/build-plugin.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@wordedits/core": "workspace:*",
    "@wordedits/shared": "workspace:*",
    "@wordedits/sidecars": "workspace:*"
  }
}
