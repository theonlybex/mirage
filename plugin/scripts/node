#!/bin/sh
# SPDX-License-Identifier: MIT
# Runs the Node.js 22 or later it can find, with all the arguments given: Mirage's hooks, engine and viewer start through
# this, so they work whether or not Node is on the PATH Claude Code was started with.
# Looked at in order: PATH, /opt/homebrew/bin/node, /usr/local/bin/node, the newest ~/.nvm/versions/node/*/bin/node,
# ~/.volta/bin/node, ~/.local/node/bin/node.
# MIRAGE_NODE_FIXED replaces the two fixed locations (a space-separated list); the tests use it.
# With no usable Node, the hook at the start of a session (last argument "session-start") can't run, so this tells Claude to ask
# about installing Node instead: in a Mirage project every time, elsewhere once (a node-notice-shown file in the data folder).

# Whether $1 is a Node of version 22 or later.
usable() {
  [ -n "$1" ] && [ -x "$1" ] || return 1
  v=$("$1" --version 2>/dev/null) || return 1
  v=${v#v}
  major=${v%%.*}
  case $major in '' | *[!0-9]*) return 1 ;; esac
  [ "$major" -ge 22 ]
}

find_node() {
  p=$(command -v node 2>/dev/null)
  if usable "$p"; then NODE=$p; return 0; fi
  for p in ${MIRAGE_NODE_FIXED-/opt/homebrew/bin/node /usr/local/bin/node}; do
    if usable "$p"; then NODE=$p; return 0; fi
  done
  home=${HOME:-}
  if [ -n "$home" ]; then
    # Newest first, versions compared as numbers: "major minor patch path" lines, sorted on the first three columns.
    p=$(
      for d in "$home"/.nvm/versions/node/v*/bin/node; do
        [ -x "$d" ] || continue
        ver=${d#"$home"/.nvm/versions/node/v}
        ver=${ver%%/*}
        printf '%s %s\n' "$(printf '%s' "$ver" | tr . ' ')" "$d"
      done | sort -k1,1nr -k2,2nr -k3,3nr | while read -r _ _ _ path; do
        if usable "$path"; then printf '%s\n' "$path"; break; fi
      done
    )
    if [ -n "$p" ]; then NODE=$p; return 0; fi
    for p in "$home/.volta/bin/node" "$home/.local/node/bin/node"; do
      if usable "$p"; then NODE=$p; return 0; fi
    done
  fi
  return 1
}

if find_node; then
  exec "$NODE" "$@"
fi

# No Node. At the start of a session, say so to Claude (the text has no double quotes or backslashes, so it is valid JSON as is).
for last; do :; done
if [ "$last" = session-start ]; then
  show=
  if [ -e "${CLAUDE_PROJECT_DIR:-$PWD}/mirage.json" ]; then
    show=1
  elif [ -n "${CLAUDE_PLUGIN_DATA:-}" ] && [ ! -e "$CLAUDE_PLUGIN_DATA/node-notice-shown" ]; then
    show=1
    mkdir -p "$CLAUDE_PLUGIN_DATA" 2>/dev/null && : >"$CLAUDE_PLUGIN_DATA/node-notice-shown" 2>/dev/null
  fi
  if [ -n "$show" ]; then
    notice="Mirage, the video-editing plugin, needs Node.js 22 or later, and this computer doesn't have it (or has an older one), so none of Mirage works yet. At the start of your first reply, before anything else, ask the person whether to install Node now, and say it runs Mirage itself: its engine and the viewer they watch their videos in. Use the mirage:setup skill (step 1) to install it. After Node is installed they need to start a new Claude Code session."
    printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"'"$notice"'"}}'
  fi
  exit 0
fi
echo 'Mirage needs Node.js 22 or later. Run /mirage:setup.' >&2
exit 1
